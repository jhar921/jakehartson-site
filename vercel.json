{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.jakehartson.com"
        }
      ],
      "destination": "https://jakehartson.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/jake-hartson.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Jake Hartson.vcf\""
        }
      ]
    }
  ]
}
