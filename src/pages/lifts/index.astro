---
import '../../styles/global.css';

const siteUrl = 'https://jakehartson.com';
const title = 'StrongLifts 5×5 · Jake Hartson';
const description =
  'Personal StrongLifts 5×5 progress tracker. Next workout, log sets, and recommended weights. Data stays in your browser.';
// Cloudflare Pages serves directory index at /lifts/ (and redirects /lifts).
const pageUrl = `${siteUrl}/lifts/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="theme-color" content="#0F766E" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="5×5" />
    <meta name="mobile-web-app-capable" content="yes" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="lifts-page">
    <a class="visually-hidden" href="#lifts-app">Skip to tracker</a>
    <div
      id="lifts-app"
      style="padding-top: max(1rem, env(safe-area-inset-top)); padding-bottom: max(2rem, env(safe-area-inset-bottom));"
    >
      <p class="lifts-boot">Loading tracker…</p>
    </div>
    <script>
      import { mountLiftsTracker } from '../../scripts/lifts-ui';
      const root = document.getElementById('lifts-app');
      if (root) mountLiftsTracker(root);
    </script>
  </body>
</html>

<style is:global>
  .lifts-page {
    min-height: 100dvh;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .lifts-boot {
    margin: 2rem auto;
    max-width: 28rem;
    padding: 0 var(--section-x);
    color: var(--color-stone);
  }

  .lifts-shell {
    width: min(100%, 32rem);
    margin: 0 auto;
    padding: 1rem var(--section-x) 3rem;
  }

  .lifts-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .lifts-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    line-height: 1.15;
    color: var(--color-ink);
  }

  .lifts-sub {
    margin: 0.5rem 0 0;
    color: var(--color-stone);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .lifts-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin: 1.25rem 0 0.75rem;
  }

  .lifts-tab {
    min-height: 48px;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
  }

  .lifts-tab.is-active {
    background: var(--color-teal);
    border-color: var(--color-teal);
    color: #f7faf8;
  }

  .lifts-status {
    min-height: 1.5rem;
    margin: 0 0 0.75rem;
    color: var(--color-teal);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .lifts-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lifts-workout-banner {
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    background: var(--color-fog);
    border: 1px solid var(--color-line);
  }

  .lifts-h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .lifts-h2-spaced {
    margin-top: 0.5rem;
  }

  .lifts-next {
    margin: 0.35rem 0 0;
    color: var(--color-stone);
    font-size: 0.9375rem;
  }

  .lifts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lifts-card {
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: #fff;
  }

  .lifts-card.is-focus {
    border-color: var(--color-teal);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-teal) 35%, transparent);
  }

  .lifts-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .lifts-h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
  }

  .lifts-scheme {
    color: var(--color-stone);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .lifts-badge {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .lifts-badge.ok {
    background: color-mix(in srgb, var(--color-teal) 18%, white);
    color: var(--color-teal);
  }

  .lifts-badge.miss {
    background: #f3e8e8;
    color: #8a3a3a;
  }

  .lifts-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .lifts-field label,
  .lifts-sets legend {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .lifts-optional {
    font-weight: 400;
    color: var(--color-stone);
  }

  .lifts-field input[type='number'],
  .lifts-field input[type='text'],
  .lifts-set input {
    width: 100%;
    min-height: 48px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
  }

  .lifts-help {
    margin: 0;
    color: var(--color-stone);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .lifts-sets {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
  }

  .lifts-set-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .lifts-set label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-stone);
    font-weight: 600;
  }

  .lifts-tip {
    margin: 0;
    color: var(--color-stone);
    font-size: 0.8125rem;
  }

  .lifts-complete {
    width: 100%;
    min-height: 52px;
    font-size: 1.0625rem;
  }

  .lifts-weight-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #fff;
    overflow: hidden;
  }

  .lifts-weight-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    min-height: 48px;
    align-items: center;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }

  .lifts-weight-list li:first-child {
    border-top: 0;
  }

  .lifts-history {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lifts-history li {
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: #fff;
  }

  .lifts-hist-top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    font-size: 0.9375rem;
  }

  .lifts-history p {
    margin: 0;
    color: var(--color-stone);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .lifts-backup {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lifts-backup .btn-secondary,
  .lifts-file-label {
    cursor: pointer;
    background: #fff;
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .lifts-file-label {
    position: relative;
  }

  @media (max-width: 420px) {
    .lifts-set-grid {
      grid-template-columns: repeat(min(var(--cols, 5), 3), minmax(0, 1fr));
    }
  }
</style>
