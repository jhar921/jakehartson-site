---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import HowICanHelp from '../components/HowICanHelp.astro';
import WantToTalk from '../components/WantToTalk.astro';
import NotReadyToText from '../components/NotReadyToText.astro';
import About from '../components/About.astro';
import WritingStartHere from '../components/WritingStartHere.astro';
import SiteFooter from '../components/SiteFooter.astro';

const siteUrl = 'https://jakehartson.com';
const title = 'Jake Hartson | Faith at work, in Orange County';
const description = 'I help people live out their faith at work, talk about Jesus with the people they already know, and wrestle with the questions that come up along the way.';
const ogImage = `${siteUrl}/og-image.jpg`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FBBF24" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="bg-off-white">
    <main>
      <Hero />
      <HowICanHelp />
      <WantToTalk />
      <NotReadyToText />
      <About />
      <WritingStartHere />
    </main>
    <SiteFooter />
  </body>
</html>
