---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/jake-hero.jpg';

const siteUrl = 'https://jakehartson.com';
const title = 'Jake Hartson';
const description = 'Founder and strategist. Orange County.';
const cardUrl = `${siteUrl}/card`;
const ogImage = `${siteUrl}/og-image.jpg`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cardUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={cardUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0F766E" />
    <meta name="apple-mobile-web-app-title" content="Jake Hartson" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main
      class="flex min-h-dvh flex-col items-center justify-center px-[var(--section-x)] py-10"
      style="padding-top: max(2.5rem, env(safe-area-inset-top)); padding-bottom: max(2.5rem, env(safe-area-inset-bottom));"
    >
      <div class="flex w-full max-w-[400px] flex-col items-center">
        <Image
          src={heroPhoto}
          alt="Jake Hartson"
          width={320}
          height={384}
          loading="eager"
          fetchpriority="high"
          class="h-48 w-40 rounded-xl object-cover object-top"
        />

        <h1 class="font-display type-display mt-6 mb-2 text-center text-ink">
          Jake Hartson
        </h1>
        <p class="mb-8 text-center font-sans text-base text-stone">
          Founder and strategist
        </p>

        <div class="flex w-full flex-col gap-3">
          <a
            href="/jake-hartson.vcf"
            download="Jake Hartson.vcf"
            type="text/vcard"
            class="btn-primary w-full min-h-14 text-lg"
          >
            Save to contacts
          </a>
          <a
            href="sms:+18582912054"
            class="btn-secondary w-full min-h-14 border-ink text-lg text-ink hover:bg-ink hover:text-paper"
          >
            Text me
          </a>
          <a
            href="mailto:jake@jakehartson.com"
            class="btn-secondary w-full min-h-14 border-ink text-lg text-ink hover:bg-ink hover:text-paper"
          >
            Email
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
