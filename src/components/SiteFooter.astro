---
import { Image } from 'astro:assets';
import logoImg from '../assets/jake-logo.png';

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-[var(--content-max)] border-t border-line px-[var(--section-x)] py-10">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-center gap-3">
      <Image
        src={logoImg}
        alt=""
        width={32}
        height={32}
        loading="lazy"
        class="opacity-70"
      />
      <div>
        <p class="font-sans text-sm text-stone">
          &copy; {year} Jake Hartson. Orange County, CA.
        </p>
        <p class="mt-1 font-sans text-sm text-stone">
          Personal site for marketplace work and introductions.
        </p>
      </div>
    </div>
    <div class="font-sans text-sm text-stone">
      <p>
        <a href="mailto:jake@jakehartson.com" class="link-inline">jake@jakehartson.com</a>
      </p>
      <p class="mt-2">
        Business education:
        <a href="https://theclaritycompany.com" target="_blank" rel="noopener noreferrer" class="link-inline">
          The Clarity Company
        </a>
      </p>
      <p class="mt-2">
        <a href="/card" class="link-inline">Save contact card</a>
      </p>
    </div>
  </div>
</footer>
