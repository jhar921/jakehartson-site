---
import { Image } from 'astro:assets';
import logoImg from '../assets/jake-logo.png';

const year = new Date().getFullYear();
---

<footer class="w-full max-w-[640px] mx-auto px-[var(--section-x)] py-10 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
  <div class="flex items-center gap-3">
    <Image
      src={logoImg}
      alt="Jake Hartson logo."
      width={32}
      height={32}
      loading="lazy"
      class="opacity-70"
    />
    <span class="font-sans text-sm text-gray-400">
      &copy; {year} Jake Hartson. Orange County, CA.
    </span>
  </div>
  <p class="font-sans text-sm text-gray-400">
    Not a texter?{' '}
    <a
      href="mailto:jake@jakehartson.com"
      class="link-inline"
    >
      jake@jakehartson.com
    </a>
  </p>
</footer>
