---
// Approved copy (Doyle Home Copy 2026-10-24, section 3). Word for word, live
// site order, no years. About is the sixth line.
import { Image } from 'astro:assets';
import familyPhoto from '../assets/jake-family.jpg';

const items = [
  ['Strategy consulting practice.', 'Founded and grew a strategy and people-development practice to six figures.'],
  ['USC Marshall School of Business.', "Master's in business."],
  ['U.S. Army officer.', 'Infantry leadership and Civil Affairs.'],
  ['Organization development.', 'Pepperdine MSOD courses, Patterson Center strategic planning certification, GIANT leadership coaching.'],
  ['Operator background.', 'Nonprofit and enterprise operations, systems, SOPs, workflow modernization.'],
  ['About.', 'Lives in Orange County with his wife Kinsey and their four kids.'],
];
---

<section class="mx-auto w-full max-w-[var(--content-max)] px-[var(--section-x)] py-[var(--section-y)]" aria-label="History">
  <ul class="space-y-6">
    {items.map(([title, detail]) => (
      <li class="border-t border-line pt-5 font-sans text-base leading-relaxed text-ink">
        <strong class="font-semibold">{title}</strong> {detail}
      </li>
    ))}
  </ul>
  <Image
    src={familyPhoto}
    alt="Jake with Kinsey and their four kids."
    width={900}
    widths={[400, 640, 720, 900]}
    sizes="(min-width: 672px) 608px, calc(100vw - 2.5rem)"
    loading="lazy"
    class="mt-8 w-full rounded-xl object-cover"
  />
</section>
