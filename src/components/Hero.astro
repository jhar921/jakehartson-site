---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/jake-hero.jpg';
---

<section class="w-full max-w-[640px] mx-auto px-[var(--section-x)] pt-[var(--section-y)] pb-[var(--section-y)]">
  <div class="flex flex-col md:flex-row md:items-start md:gap-10">
    <div class="flex-1 order-2 md:order-1 mt-8 md:mt-0">
      <p class="text-sm font-sans tracking-widest text-honey uppercase mb-4">
        It doesn't always have to be loud.
      </p>
      <h1 class="font-serif type-display mb-5 text-near-black">
        I help people live their faith on a Monday.
      </h1>
      <p class="font-sans text-lg leading-relaxed text-near-black prose-body mb-4">
        At work, with the friends they already have, and in the questions they can't ask out loud anywhere else.
      </p>
      <p class="font-sans text-base leading-relaxed text-near-black prose-body">
        I'm Jake. I live in Orange County with my wife Kinsey and our four kids. If you'd like to talk, text me at (858) 291-2054.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href="sms:+18582912054"
          class="inline-flex items-center justify-center min-h-[44px] bg-honey text-near-black font-sans font-semibold px-6 py-3 rounded-lg text-base hover:bg-honey-dark transition-colors"
        >
          Text me
        </a>
        <a
          href="tel:+18582912054"
          class="inline-flex items-center justify-center min-h-[44px] border border-near-black text-near-black font-sans font-semibold px-6 py-3 rounded-lg text-base hover:bg-near-black hover:text-off-white transition-colors"
        >
          Call me
        </a>
      </div>
    </div>
    <div class="order-1 md:order-2 w-full md:w-48 md:shrink-0">
      <Image
        src={heroPhoto}
        alt="Jake Hartson, smiling, outdoor portrait."
        width={400}
        height={480}
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-2xl object-cover object-top shadow-md"
      />
    </div>
  </div>
</section>
