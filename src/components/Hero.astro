---
// The photo covers the full viewport. On portrait screens it is height-bound,
// so its rendered width is about 84vh (1811/2161 of the height); otherwise 100vw.
// srcset lets phones pick a small variant instead of the 1811px original.
import { Image } from 'astro:assets';
import heroPhoto from '../assets/jake-hero.jpg';
---

<header class="relative isolate min-h-[100svh] w-full overflow-hidden text-paper">
  <div class="absolute inset-0 -z-10">
    <Image
      src={heroPhoto}
      alt="Jake Hartson outdoor portrait"
      width={1811}
      height={2161}
      widths={[480, 640, 828, 1080, 1280, 1440, 1811]}
      sizes="(max-aspect-ratio: 1811/2161) 84vh, 100vw"
      quality={62}
      loading="eager"
      fetchpriority="high"
      class="hero-photo h-full w-full object-cover object-[center_18%]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(8,14,12,0.82)_0%,rgba(8,14,12,0.62)_48%,rgba(8,14,12,0.28)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_20%,transparent_20%,rgba(8,14,12,0.45)_100%)]"></div>
  </div>

  <div class="mx-auto flex min-h-[100svh] w-full max-w-6xl flex-col justify-end px-[var(--section-x)] pb-16 pt-28 sm:pb-20 md:justify-center md:pb-24">
    <div class="max-w-xl hero-copy">
      <h1 class="font-display type-brand mb-5 text-paper">Jake Hartson.</h1>
      <p class="font-display type-display text-paper">Strategist and operator in Orange County.</p>
    </div>
  </div>
</header>

<style>
  .hero-photo {
    animation: hero-pan 18s ease-in-out infinite alternate;
    transform: scale(1.06);
    transform-origin: center 20%;
  }

  .hero-copy {
    animation: hero-rise 0.9s ease both;
  }

  @keyframes hero-pan {
    from {
      transform: scale(1.06) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.1) translate3d(-1.5%, -1%, 0);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo,
    .hero-copy {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
